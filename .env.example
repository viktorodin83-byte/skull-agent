# Скопируй этот файл в .env и заполни своими реальными значениями.
# Сам .env никогда не должен попадать в git — он уже добавлен в .gitignore.

# Токен Telegram-бота от @BotFather
TELEGRAM_TOKEN=

# Ключ Anthropic (Claude) API — https://console.anthropic.com/
CLAUDE_API_KEY=

# Ключ OpenAI API — используется для распознавания и синтеза речи (Whisper/TTS)
OPENAI_API_KEY=

# Резервный поиск через Google Custom Search — необязательно, можно оставить пустым
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Apify — поиск цен на Ozon/Avito (actor ru-marketplaces-price-monitor)
APIFY_API_TOKEN=

# Twelve Data — котировки XAU/USD для ноды сигналов по золоту
TWELVE_DATA_API_KEY=

# FRED (fred.stlouisfed.org) — макро-данные (реальная доходность облигаций и т.п.)
# для будущего расширения ноды золотого сигнала, пока не используется в коде
FRED_API_KEY=

# UniRateAPI (unirateapi.com) — серебро (XAG) как подтверждающий актив для золота,
# нужен Pro-тариф ($9/мес) для эндпоинта /api/commodities. Используется в skullbyte.py
UNIRATE_API_KEY=

# Токен отдельного бота SkullByte (skullbyte.py) — агент глубокого анализа XAU/USD
# по запросу. Отдельный бот в @BotFather, не путать с TELEGRAM_TOKEN основного бота
SKULLBYTE_TOKEN=
